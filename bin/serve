#!/usr/bin/env ruby
# frozen_string_literal: true

# sigma-mate сервис агента developer: держит pi-сессию открытой и
# обслуживает POST /ask {"prompt": "..."} -> ответ агента в ответе того же
# запроса. Новый запрос прерывает текущий прогон.
#
# Дополнительно слушает шину NATS: при запуске передаётся идентификатор
# агента (--agent-id или SM_AGENT_ID) и адрес шины (--nats-url или
# SM_NATS_URL); сервис слушает очередь своего идентификатора и печатает
# входящие сообщения в свой вывод. Без идентификатора подписка не
# поднимается. HTTP-адрес и порт: --host/--port или SM_HOST/SM_PORT
# (по умолчанию 127.0.0.1:4567).

require "rubygems"
require "bundler/setup"

require_relative "../lib/sigma_mate"
require_relative "../lib/sigma_mate/coordinator"
require_relative "../lib/sigma_mate/service"
require_relative "../lib/sigma_mate/bus"

module SigmaMate
  EXIT_OK = 0
  EXIT_FAILURE = 1

  module_function

  def usage
    "Использование: bin/serve [--host АДРЕС] [--port ПОРТ] " \
      "[--agent-id ИДЕНТИФИКАТОР] [--nats-url АДРЕС-ШИНЫ]\n" \
      "HTTP-адрес и порт: --host/--port или SM_HOST/SM_PORT " \
      "(по умолчанию #{DEFAULT_HOST}:#{DEFAULT_PORT})\n" \
      "Идентификатор агента: --agent-id или SM_AGENT_ID; " \
      "адрес шины NATS: --nats-url или SM_NATS_URL\n" \
      "Без идентификатора агента или адреса шины подписка на шину " \
      "не поднимается, HTTP-API продолжает работать"
  end

  # @return [Hash{Symbol => String, Integer}]
  def options(argv)
    opts = {
      host: ENV.fetch("SM_HOST", DEFAULT_HOST),
      port: ENV.fetch("SM_PORT", DEFAULT_PORT.to_s),
      agent_id: ENV.fetch("SM_AGENT_ID", nil),
      nats_url: ENV.fetch("SM_NATS_URL", nil)
    }
    args = argv.dup
    until args.empty?
      case args.shift
      when "--host" then opts[:host] = args.shift.to_s
      when "--port" then opts[:port] = args.shift.to_s
      when "--agent-id" then opts[:agent_id] = args.shift.to_s
      when "--nats-url" then opts[:nats_url] = args.shift.to_s
      when "--help", "-h"
        puts usage
        exit EXIT_OK
      else
        warn usage
        exit EXIT_FAILURE
      end
    end
    opts[:port] = opts[:port].to_i
    opts
  rescue ArgumentError, TypeError
    warn "Некорректный порт."
    warn usage
    exit EXIT_FAILURE
  end

  # Поднимает слушателя шины или печатает ошибку и возвращает nil -
  # без идентификатора агента или адреса шины подписка не поднимается.
  # @return [BusListener, nil]
  def build_bus(agent_id, nats_url)
    if agent_id.nil? || agent_id.strip.empty?
      warn "Ошибка: идентификатор агента не задан (--agent-id или " \
           "SM_AGENT_ID); подписка на шину не поднимается."
      return nil
    end
    if nats_url.nil? || nats_url.strip.empty?
      warn "Ошибка: идентификатор задан (#{agent_id}), но адрес шины " \
           "не задан (--nats-url или SM_NATS_URL); подписка на шину " \
           "не поднимается."
      return nil
    end

    BusListener.new(url: nats_url, agent_id: agent_id).start
  end

  def run(argv)
    opts = options(argv)

    coordinator = Coordinator.new(session_factory: default_session_factory)
    coordinator.start
    unless coordinator.alive?
      warn "Предупреждение: pi-сессия не поднялась (#{coordinator.session_error})."
      warn "Сервис продолжит работать и будет отвечать ошибкой 503 на запросы."
    end

    bus = build_bus(opts[:agent_id], opts[:nats_url])
    service = Service.new(coordinator: coordinator, host: opts[:host], port: opts[:port])

    %w[INT TERM].each do |sig|
      trap(sig) { service.shutdown }
    end

    puts "Sigma Mate сервис агента #{AGENT_NAME}: " \
         "http://#{opts[:host]}:#{opts[:port]} (POST /ask)"
    $stdout.flush

    service.start
    bus&.stop
    coordinator.close
    EXIT_OK
  rescue Errno::EADDRINUSE => e
    warn "Ошибка: адрес #{opts[:host]}:#{opts[:port]} занят. #{e.message}"
    EXIT_FAILURE
  end
end

if $PROGRAM_NAME == __FILE__
  exit SigmaMate.run(ARGV)
end
